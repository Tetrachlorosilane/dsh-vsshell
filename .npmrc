# Flat node_modules for local development.
#
# The executor is loaded by the DSH runtime, where `@deepseek-ai/*` imports are
# resolved by the profile's runtime interception. Locally, the smoke script and
# any other direct `node` run import `@deepseek-ai/cordis` and friends from this
# checkout's node_modules; pnpm's isolated layout leaves their transitive
# dependencies behind junctions that Node's ESM resolver does not traverse, so
# a hoisted layout is what makes the local toolchain work.
node-linker=hoisted
